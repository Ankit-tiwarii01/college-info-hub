# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-your-generated-random-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
# In production, set APP_ENV=production and list only your real frontend URLs above.
# Optional custom CORS regex:
ALLOWED_ORIGIN_REGEX=
# Default: existing local SQLite database. Optional MySQL connection:
# DATABASE_URL=mysql+mysqlconnector://user:password@localhost/college_hub
# Gmail App Password example:
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# Never use your normal Gmail password and never commit real credentials.
SMTP_USERNAME=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Campus InfoHub
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH_MODE=password
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# OAuth2 alternative. Set SMTP_AUTH_MODE=oauth2 and either provide a current
# access token or the client/refresh credentials used to obtain one.
SMTP_OAUTH2_ACCESS_TOKEN=
SMTP_OAUTH2_CLIENT_ID=
SMTP_OAUTH2_CLIENT_SECRET=
SMTP_OAUTH2_REFRESH_TOKEN=
SMTP_OAUTH2_TOKEN_URL=https://oauth2.googleapis.com/token

# Twilio Verify-by-SMS delivery (required for mobile OTP verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP policy
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS=5

# Mentorship meeting access window. WebRTC media is peer-to-peer.
MEETING_EARLY_JOIN_MINUTES=15
MEETING_LATE_GRACE_MINUTES=30
